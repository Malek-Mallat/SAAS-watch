# Copier ce fichier en .env puis adapter les valeurs (.env n'est jamais envoyé sur GitHub)
ELASTIC_VERSION=8.15.3

ES_HOST=http://elasticsearch:9200

MONGO_USER=saaswatch
MONGO_PASSWORD=change_me
MONGO_URI=mongodb://saaswatch:change_me@mongodb:27017/saaswatch?authSource=admin

REDIS_URL=redis://redis:6379/0

FLASK_SECRET_KEY=change_me_too
UPLOAD_DIR=/data/uploads

# Compte administrateur créé au premier démarrage (changer le mot de passe !)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Fuseau horaire des dates saisies dans la recherche (Tunisie = +01:00)
TZ_OFFSET=+01:00

# Kibana vu depuis le navigateur, et adresse du dashboard intégré dans la page /dashboard
# (Kibana : Share > Embed code > copier l'adresse src="...")
KIBANA_PUBLIC_URL=http://localhost:5601
KIBANA_DASHBOARD_URL=
