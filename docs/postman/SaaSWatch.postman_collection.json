      "name": "4. Recherche et statistiques",
      "item": [
        {
          "name": "Erreurs 5xx du service billing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Des résultats\", () => pm.expect(j.total).to.be.above(0));",
                  "pm.test(\"Tous billing et >= 500\", () => j.logs.forEach(l => {",
                  "  pm.expect(l.service).to.eql(\"billing\");",
                  "  pm.expect(l.status_code).to.be.at.least(500);",
                  "}));",
                  "if (j.logs.length) pm.collectionVariables.set(\"logId\", j.logs[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/logs?service=billing&status_min=500&size=10",
