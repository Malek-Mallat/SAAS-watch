          "name": "Status – 3 services ok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Elasticsearch, MongoDB, Redis ok\", () => {",
                  "  pm.expect(j.services.elasticsearch).to.eql(\"ok\");",
                  "  pm.expect(j.services.mongodb).to.eql(\"ok\");",
                  "  pm.expect(j.services.redis).to.eql(\"ok\");",
                  "});",
                  "pm.test(\"Des logs sont indexés\", () => pm.expect(j.logs_indexes).to.be.above(0));"
